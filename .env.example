# Parlay Predictor — environment template.
# Copy to .env.local and fill with real values. NEVER commit .env.local.

# --- AI (Groq) ---
GROQ_API_KEY=
# Optional: override the primary model (defaults to llama-3.3-70b-versatile)
# GROQ_MODEL=

# --- Web search (Tavily) ---
TAVILY_API_KEY=

# --- Soccer fixtures (football-data.org) ---
FOOTBALL_DATA_API_KEY=

# --- Real-time odds (The Odds API) ---
ODDS_API_KEY=

# --- Database + Auth (Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
